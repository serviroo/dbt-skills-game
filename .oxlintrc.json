{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": { "correctness": "off" },
  "jsPlugins": ["./scripts/lint/rules.mjs"],
  "ignorePatterns": ["scripts/lint/fixtures/**"],
  "overrides": [
    {
      "files": ["src/**"],
      "rules": {
        "lantern/audio-times-from-soon": "error",
        "lantern/controls-wait-for-opening": "error",
        "lantern/late-opens-build-again": "error",
        "lantern/hold-reads-the-scheduled-curve": "error",
        "lantern/held-times-are-clamped": "error",
        "lantern/animations-share-start-time": "error",
        "lantern/follow-device-preferences": "error",
        "lantern/no-soft-hyphen-characters": "error",
        "lantern/stored-writes-go-through-cleared": "error",
        "lantern/handle-lost-gpu-context": "error",
        "lantern/schedule-before-echo-loads": "error",
        "lantern/bus-rises-wait-for-stops": "error",
        "lantern/bus-levels-use-tracked-curves": "error",
        "lantern/timed-cues-are-prebuilt": "error"
      }
    },
    {
      "files": ["src/audio/**"],
      "rules": {
        "lantern/graph-swaps-wait-for-their-time": "error",
        "lantern/cue-tracking-includes-offline": "error",
        "lantern/cue-cleanup-shares-one-clock": "error"
      }
    },
    {
      "files": ["src/audio/prebuild.ts"],
      "rules": { "lantern/timed-cues-are-prebuilt": "off" }
    },
    {
      "files": ["src/ui/anim.ts"],
      "rules": { "lantern/animations-share-start-time": "off" }
    },
    {
      "files": ["src/core/cleared.ts", "src/daily/store.ts", "src/daily/clear.ts", "src/labs/**"],
      "rules": { "lantern/stored-writes-go-through-cleared": "off" }
    },
    {
      "files": ["scripts/**"],
      "rules": {
        "lantern/tap-elements-not-points": "error",
        "lantern/clock-calls-go-through-clock-module": "error",
        "lantern/no-cross-render-peak-equality": "error"
      }
    },
    {
      "files": ["scripts/e2e/clock.mjs"],
      "rules": { "lantern/clock-calls-go-through-clock-module": "off" }
    }
  ]
}
